new file mode 100644
index 00000000..66096adf
--- /dev/null
+++ b/genesis/engine/materials/MPM/nacc.py
@@ -0,0 +1,164 @@
+import math
+from typing import Annotated, Any
+
+import quadrants as qd
+from pydantic import Field, StrictBool
+
+import genesis as gs
+from genesis.typing import NonNegativeFloat, PositiveFloat, ValidFloat
+
+from .base import Base
+
+
+@qd.data_oriented
+class NACC(Base):
+    """Non-Associated Cam-Clay plasticity from Wolper et al. (2019).
+
+    This is the local, fracture-friendly plasticity component of CD-MPM.  It
+    uses the Borden Neo-Hookean energy and the analytical three-case NACC
+    return mapping from the authors' Ziran implementation.  It does not
+    include CD-MPM's phase field, damage variable, or non-local crack solve.
+
+    ``Jp`` in the stock Genesis MPM particle state stores NACC's scalar
+    hardening variable ``alpha`` (called ``logJp`` in the Ziran code).  This
+    lets the model run without changing the MPM solver or particle layout.
+
+    Parameters
+    ----------
+    E, nu, rho, sampler
+        Standard MPM material and sampling parameters inherited from ``Base``.
+    initial_log_jp : float, optional
+        Initial hardening state alpha_0 = log(Jp_0).  Negative values give a
+        finite initial yield surface.  Default is log(0.99).
+    friction_angle : float, optional
+        Friction angle in degrees.  It is converted to the NACC yield-surface
+        parameter M using the formula in the released Ziran code.  Default is
+        58 degrees (M approximately 2.36 in 3D).
+    beta : float, optional
+        Cohesion coefficient controlling the tensile side of the yield
+        surface.  Default is 0.5.
+    xi : float, optional
+        Hardening/softening rate.  Default is 1.0.
+    hardening : bool, optional
+        Whether to evolve alpha after plastic projection.  Default is True.
+    """
+
+    initial_log_jp: ValidFloat = math.log(0.99)
+    friction_angle: Annotated[ValidFloat, Field(gt=0.0, lt=90.0)] = 58.0
+    beta: NonNegativeFloat = 0.5
+    xi: NonNegativeFloat = 1.0
+    hardening: StrictBool = True
+
+    # Derived parameters.  K is named kappa to match the paper and Ziran.
+    M: PositiveFloat = Field(default=1.0, exclude=True)
+    kappa: PositiveFloat = Field(default=1.0, exclude=True)
+
+    def model_post_init(self, context: Any) -> None:
+        super().model_post_init(context)
+
+        self.kappa = self.lam + (2.0 / 3.0) * self.mu
+        sin_phi = math.sin(math.radians(self.friction_angle))
+        mohr_coulomb_friction = math.sqrt(2.0 / 3.0) * 2.0 * sin_phi / (3.0 - sin_phi)
+        self.M = mohr_coulomb_friction * 3.0 / math.sqrt(2.0 / 3.0)
+
+        # Reuse the one scalar history slot already present on every Genesis
+        # MPM particle.  For NACC it is alpha, not a plastic volume ratio.
+        self._default_Jp = float(self.initial_log_jp)
+        self.update_F_S_Jp = self._update_F_S_Jp_nacc
+        self.update_stress = self._update_stress_nacc
+        self.needs_svd = True
+
+    @qd.func
+    def _update_F_S_Jp_nacc(self, J, F_tmp, U, S, V, Jp):
+        """Apply the analytical NACC return map to the trial elastic F."""
+        dim = qd.static(3)
+        eps = gs.qd_float(1.0e-8)
+
+        sigma_sq = qd.Vector.zero(gs.qd_float, 3)
+        sigma_new = qd.Matrix.zero(gs.qd_float, 3, 3)
+        for d in qd.static(range(3)):
+            sigma_sq[d] = S[d, d] * S[d, d]
+            sigma_new[d, d] = S[d, d]
+
+        J_trial = qd.max(J, eps)
+        mean_b = sigma_sq.sum() / 3.0
+        s_trial = self.mu * J_trial ** (-2.0 / 3.0) * (sigma_sq - mean_b)
+        s_trial_norm = s_trial.norm(eps)
+
+        # Compression is positive pressure in the CD-MPM convention.
+        p_trial = -0.5 * self.kappa * (J_trial * J_trial - 1.0)
+        hardening_argument = self.xi * qd.max(-Jp, 0.0)
+        sinh_argument = 0.5 * (qd.exp(hardening_argument) - qd.exp(-hardening_argument))
+        p0 = self.kappa * (1.0e-5 + sinh_argument)
+
+        alpha_new = Jp
+        projected = gs.qd_bool(False)
+
+        # Cases 1 and 2: the trial pressure lies beyond an ellipsoid tip.
+        p_projected = gs.qd_float(0.0)
+        if p_trial > p0:
+            p_projected = p0
+            projected = True
+        elif p_trial < -self.beta * p0:
+            p_projected = -self.beta * p0
+            projected = True
+
+        if projected:
+            J_new = qd.sqrt(qd.max(1.0 - 2.0 * p_projected / self.kappa, eps))
+            isotropic_stretch = J_new ** (1.0 / dim)
+            for d in qd.static(range(3)):
+                sigma_new[d, d] = isotropic_stretch
+            if qd.static(self.hardening):
+                alpha_new += qd.log(J_trial / J_new)
+        else:
+            # Case 3: preserve pressure/volume and radially return the shear
+            # stress to the NACC ellipsoid when the trial state has yielded.
+            shear_coeff = 0.5 * (6.0 - dim) * (1.0 + 2.0 * self.beta)
+            pressure_term = self.M * self.M * (p_trial + self.beta * p0) * (p_trial - p0)
+            yield_value = shear_coeff * s_trial_norm * s_trial_norm + pressure_term
+
+            if yield_value >= 1.0e-4:
+                target_s_norm = qd.sqrt(qd.max(-pressure_term / shear_coeff, 0.0))
+                b_new = target_s_norm / self.mu * J_trial ** (2.0 / 3.0) * s_trial / s_trial_norm + mean_b
+                for d in qd.static(range(3)):
+                    sigma_new[d, d] = qd.sqrt(qd.max(b_new[d], eps))
+
+                if qd.static(self.hardening):
+                    # Fracture-friendly shear hardening/softening: intersect
+                    # the center-to-trial ray with the yield ellipse and use
+                    # its pressure to update alpha.  This is the exact closed
+                    # form used by the released Ziran implementation.
+                    p_center = 0.5 * (1.0 - self.beta) * p0
+                    if p0 > 1.0e-4 and p_trial < p0 - 1.0e-4 and p_trial > -self.beta * p0 + 1.0e-4:
+                        aa = (
+                            self.M
+                            * self.M
+                            * (p_trial - p_center)
+                            * (p_trial - p_center)
+                            / (shear_coeff * s_trial_norm * s_trial_norm)
+                        )
+                        dd = 1.0 + aa
+                        ff = aa * self.beta * p0 - aa * p0 - 2.0 * p_center
+                        gg = p_center * p_center - aa * self.beta * p0 * p0
+                        root = qd.sqrt(qd.abs(ff * ff - 4.0 * dd * gg))
+                        p1 = (-ff + root) / (2.0 * dd)
+                        p2 = (-ff - root) / (2.0 * dd)
+                        p_intersection = p2
+                        if (p_trial - p_center) * (p1 - p_center) > 0.0:
+                            p_intersection = p1
+                        J_intersection = qd.sqrt(qd.abs(1.0 - 2.0 * p_intersection / self.kappa))
+                        if J_intersection > 1.0e-4:
+                            alpha_new += qd.log(J_trial / J_intersection)
+
+        F_new = U @ sigma_new @ V.transpose()
+        return F_new, sigma_new, alpha_new
+
+    @qd.func
+    def _update_stress_nacc(self, U, S, V, F_tmp, F_new, J, Jp, actu, m_dir, phase):
+        """Kirchhoff stress of the undegraded Borden Neo-Hookean energy."""
+        J_elastic = qd.max(S[0, 0] * S[1, 1] * S[2, 2], 1.0e-8)
+        b = F_new @ F_new.transpose()
+        dev_b = b - qd.Matrix.identity(gs.qd_float, 3) * (b.trace() / 3.0)
+        stress = self.mu * J_elastic ** (-2.0 / 3.0) * dev_b
+        stress += qd.Matrix.identity(gs.qd_float, 3) * (0.5 * self.kappa * (J_elastic * J_elastic - 1.0))
+        return stress
