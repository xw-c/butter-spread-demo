new file mode 100644
index 00000000..395e9de8
--- /dev/null
+++ b/genesis/engine/materials/MPM/phase_field.py
@@ -0,0 +1,98 @@
+from typing import Annotated, Any
+
+import quadrants as qd
+from pydantic import Field, StrictInt
+
+import genesis as gs
+from genesis.typing import NonNegativeFloat, PositiveFloat, ValidFloat
+
+from .base import Base
+
+
+@qd.data_oriented
+class PhaseField(Base):
+    """Brittle phase-field fracture material used by CD-MPM/PFF-MPM.
+
+    This material implements the tensile/compressive split of the Borden
+    Neo-Hookean energy from Wolper et al. (2019).  The accompanying non-local
+    phase-field equation is solved by :class:`MPMSolver`; ``c=1`` denotes
+    intact material and ``c=0`` fully damaged material.
+
+    Parameters
+    ----------
+    fracture_toughness : float
+        Critical energy release rate ``G`` in J/m^2.
+    length_scale : float
+        Phase-field regularization length ``l0`` in meters.  Zero selects the
+        paper's MPM default, ``l0 = 0.5 * grid_dx``.
+    mobility : float
+        Ginzburg--Landau mobility ``Mc``.  Positive values use the parabolic
+        backward-Euler phase evolution from Eq. (6).  Zero selects its
+        rate-independent elliptic limit.
+    residual_stiffness : float
+        Residual tensile stiffness ``r`` in ``g(c)=(1-r)c^2+r``.
+    cg_max_iterations, cg_tolerance
+        Maximum iterations and relative residual tolerance for the grid phase
+        solve.  The released Ziran examples generally converge in 1--4 CG
+        iterations; a larger default is used here for robustness.
+    """
+
+    E: PositiveFloat = 2.0e6
+    nu: Annotated[ValidFloat, Field(gt=-1.0, lt=0.5)] = 0.22
+    rho: PositiveFloat = 550.0
+
+    fracture_toughness: PositiveFloat = 20.0
+    length_scale: NonNegativeFloat = 0.0
+    mobility: NonNegativeFloat = 1.0
+    residual_stiffness: Annotated[ValidFloat, Field(gt=0.0, le=1.0)] = 1.0e-3
+    cg_max_iterations: Annotated[StrictInt, Field(ge=1)] = 12
+    cg_tolerance: PositiveFloat = 1.0e-5
+    kappa: PositiveFloat = Field(default=1.0, exclude=True)
+
+    def model_post_init(self, context: Any) -> None:
+        super().model_post_init(context)
+
+        self.kappa = self.lam + (2.0 / 3.0) * self.mu
+        self.update_F_S_Jp = self._update_F_S_Jp_phase_field
+        self.update_stress = self._update_stress_phase_field
+        self.needs_svd = False
+
+    @property
+    def use_phase_field(self) -> bool:
+        return True
+
+    @qd.func
+    def _update_F_S_Jp_phase_field(self, J, F_tmp, U, S, V, Jp):
+        return F_tmp, S, Jp
+
+    @qd.func
+    def _update_stress_phase_field(self, U, S, V, F_tmp, F_new, J, Jp, actu, m_dir, phase):
+        """Degraded Kirchhoff stress of Eq. (3) and Eqs. (8)--(10)."""
+        eps = gs.qd_float(1.0e-8)
+        J_elastic = qd.max(F_new.determinant(), eps)
+        b = F_new @ F_new.transpose()
+        dev_b = b - qd.Matrix.identity(gs.qd_float, 3) * (b.trace() / 3.0)
+
+        tau_dev = self.mu * J_elastic ** (-2.0 / 3.0) * dev_b
+        tau_vol = qd.Matrix.identity(gs.qd_float, 3) * (
+            0.5 * self.kappa * (J_elastic * J_elastic - 1.0)
+        )
+        degradation = (1.0 - self.residual_stiffness) * phase * phase + self.residual_stiffness
+
+        stress = degradation * tau_dev + tau_vol
+        if J_elastic >= 1.0:
+            stress = degradation * (tau_dev + tau_vol)
+        return stress
+
+    @qd.func
+    def _positive_energy(self, F):
+        """Undegraded tensile energy density ``Psi+`` used by the history field."""
+        eps = gs.qd_float(1.0e-8)
+        J = qd.max(F.determinant(), eps)
+        frobenius_sq = (F.transpose() @ F).trace()
+        psi_dev = 0.5 * self.mu * (J ** (-2.0 / 3.0) * frobenius_sq - 3.0)
+        psi_vol = 0.5 * self.kappa * (0.5 * (J * J - 1.0) - qd.log(J))
+        psi_pos = qd.max(psi_dev, 0.0)
+        if J >= 1.0:
+            psi_pos = qd.max(psi_dev + psi_vol, 0.0)
+        return psi_pos
